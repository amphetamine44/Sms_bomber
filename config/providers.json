{
  "sendotp": {
    "method": "post",
    "url": "https://api.sendotp.dev/v1/send_otp",
    "headers": {
      "Authorization": "Bearer YOUR_SENDOTP_API_KEY",
      "Content-Type": "application/json"
    },
    "parameters": {
      "phone": "Replace phonenumber here"
    },
    "identifier": "The OTP was sent successfully"
  },
  "taqnyat_sa": {
    "method": "post",
    "url": "https://api.taqnyat.sa/v1/verify/send",
    "headers": {
      "Authorization": "Bearer YOUR_TAQNYAT_TOKEN",
      "Content-Type": "application/json"
    },
    "parameters": {
      "numbers": ["Replace phonenumber here"],
      "method": "sms",
      "sender": "YOUR_SENDER_NAME",
      "lang": "ar",
      "requestId": "1"
    },
    "identifier": "5"
  }
}
